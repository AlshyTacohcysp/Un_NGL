# Copy to .env.local and fill in. After ANY change to .env.local: stop and
# restart `pnpm dev` (Next.js only reads env files at startup).

# --- Supabase (Dashboard -> Project Settings -> API) -------------------------

# Project URL
NEXT_PUBLIC_SUPABASE_URL=https://REF.supabase.co

# Publishable key: `sb_publishable_...` (new) or `eyJ...` (legacy anon key).
# Both are valid. Do NOT invent an `sb.` prefix.
# NEXT_PUBLIC_ is a Next.js rule: without the prefix the browser bundle has no
# key and createBrowserClient throws "URL and API key are required" when the
# Google button is clicked.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (server-only, bypasses RLS): `sb_secret_...` (new) or `eyJ...`
# (legacy service_role). NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Colour-hint HMAC secret (server-only). Used to derive message hint colours
# and the hashes stored in send_rate. NEVER prefix with NEXT_PUBLIC_.
# Generate with: openssl rand -base64 32
HINT_SECRET=

# --- Legacy variable names (still accepted by the code) ----------------------
# NEXT_PUBLIC_SUPABASE_ANON_KEY=          (instead of NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY)
# SUPABASE_SERVICE_ROLE_KEY=              (instead of SUPABASE_SECRET_KEY)

# --- OAuth redirect URLs (do not confuse these two) --------------------------
# * In the Google Cloud console, Authorized redirect URI = the Supabase one:
#     https://REF.supabase.co/auth/v1/callback
#   (NOT localhost)
# * In Supabase (Authentication -> URL Configuration), Redirect URLs =
#     http://localhost:3000/auth/callback
#   (add the Vercel URL later). Site URL (local) = http://localhost:3000
# Open http://localhost:3000 (localhost, not 127.0.0.1).
